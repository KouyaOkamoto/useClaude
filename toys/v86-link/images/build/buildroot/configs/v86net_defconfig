# v86-link のゲスト Linux（v86 の i686・ne2k・シリアルコンソール）
# Buildroot 2025.02.x（LTS）用。ビルドは ../build.sh から（カーネルの設定はそこで tinyconfig + 断片から作る）

# --- アーキテクチャ・ツールチェーン（Buildroot が作る。libc は uClibc-ng。build.sh の LIBC で musl / glibc に切り替えられる）
BR2_x86_i686=y
BR2_TOOLCHAIN_BUILDROOT_UCLIBC=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_6_12=y
BR2_CCACHE=y
BR2_OPTIMIZE_S=y

# --- システム（起動後の挙動は、いまのイメージに合わせる。inittab・profile・fstab はオーバーレイで置く）
BR2_TARGET_GENERIC_HOSTNAME="buildroot"
BR2_TARGET_GENERIC_ISSUE="Welcome to Buildroot"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_V86NET_PATH)/board/v86net/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_V86NET_PATH)/board/v86net/post-build.sh"

# --- カーネル（6.12 LTS。Buildroot にチェックサムが登録されている版。設定は build.sh が作るファイル）
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BASE_DIR)/v86net-kernel.config"
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# --- ルートファイルシステム（initramfs をカーネルに埋め込む。v86 は initrd を固定位置に置くので、別ファイルにしない）
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_NONE=y
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set

# --- BusyBox（Buildroot の既定の設定 + 断片）
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_V86NET_PATH)/board/v86net/busybox.fragment"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# --- いまのイメージにあるもの
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_SOCAT=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y

# --- 追加: ファイアウォール・NAT（iptables は legacy と nft の両方、nft コマンド）
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_IPTABLES_NFTABLES=y
BR2_PACKAGE_NFTABLES=y
# --- 追加: iproute2（ip・tc・bridge）・ブリッジ
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_BRIDGE_UTILS=y
BR2_PACKAGE_ETHTOOL=y
# --- 追加: DHCP / DNS・SSH・スキャナ
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_NMAP=y
BR2_PACKAGE_NMAP_NMAP=y
BR2_PACKAGE_NMAP_NCAT=y
