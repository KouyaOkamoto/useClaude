# v86 で動かすための最小限（make ARCH=i386 tinyconfig に重ねる）。docs/image-survey.md の付録 A をもとにしたもの
CONFIG_M686=y
# CONFIG_SMP is not set
CONFIG_NOHIGHMEM=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_POSIX_TIMERS=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# コンソールは、いまのイメージと同じく VGA（tty0）。カーネルのメッセージはシリアルに出さない。シェルは inittab で ttyS0 にも出す
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PCI=y
CONFIG_PCI_GOANY=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_8390=y
CONFIG_NE2K_PCI=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
# ふつうのユーザーランド（libc・iptables・dnsmasq など）が使うシステムコール（tinyconfig では抜ける）
CONFIG_EXPERT=y
CONFIG_FILE_LOCKING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FHANDLE=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_KCMP=y
CONFIG_SGETMASK_SYSCALL=y
CONFIG_SYSFS_SYSCALL=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_BPF_SYSCALL=y
CONFIG_INOTIFY_USER=y
